From: huxin <wb-hx963136@alibaba-inc.com>
Date: Mon, 24 Feb 2025 17:23:34 +0800
Subject: [PATCH] Fix yocto build error

---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index bffd96077..d75aaf6cf 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -331,7 +331,7 @@ if(NOT MSVC)
   endif()
 
 execute_process(
-  COMMAND bash -c "riscv64-unknown-linux-gnu-gcc -E -dM -</dev/null | grep __GNUC__ | awk '{print $3}'"
+  COMMAND bash -c "riscv64-linux-gcc -E -dM -</dev/null | grep __GNUC__ | awk '{print $3}'"
   OUTPUT_VARIABLE XT_GCC_VERSION
   OUTPUT_STRIP_TRAILING_WHITESPACE
 )
