diff --git a/arch/riscv/cpu/xuantie/cache.c b/arch/riscv/cpu/xuantie/cache.c
new file mode 100644
index 0000000000..ff1aff68af
--- /dev/null
+++ b/arch/riscv/cpu/xuantie/cache.c
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (c) 2026 Alibaba-inc, DAMO
+ *
+ * Cache operations for XuanTie RISC-V CPUs with runtime detection.
+ *
+ * Legacy C9xx CPUs (c906/c910/c920) use XuanTie custom cache
+ * instructions; newer XuanTie cores and other RISC-V vendors fall
+ * back to standard Zicbom.
+ */
+
+#include <asm/cache.h>
+#include <cpu_func.h>
+#include <asm/insn-def.h>
+
+#if CONFIG_IS_ENABLED(RISCV_SMODE)
+#include <asm/sbi.h>
+#endif
+
+#define XUANTIE_VENDOR_ID		0x5b7
+
+/* XuanTie C9xx custom cache instruction encodings */
+#define XUANTIE_ICACHE_IALL	".long 0x0100000b"
+#define XUANTIE_DCACHE_CALL	".long 0x0010000b"
+#define XUANTIE_DCACHE_IALL	".long 0x0020000b"
+#define XUANTIE_DCACHE_CIPA_A0	".long 0x02b5000b"
+#define XUANTIE_DCACHE_IPA_A0	".long 0x02a5000b"
+#define XUANTIE_SYNC_S		".long 0x0190000b"
+#define XUANTIE_SYNC_I		".long 0x01a0000b"
+
+/* Standard RISC-V Zicbom cache instructions via insn-def.h */
+#define CBO_INVAL_A0 \
+	INSN_I(OPCODE_MISC_MEM, FUNC3(2), __RD(0), RS1(a0), SIMM12(0))
+#define CBO_FLUSH_A0 \
+	INSN_I(OPCODE_MISC_MEM, FUNC3(2), __RD(0), RS1(a0), SIMM12(2))
+#define CBO_FLUSH_A0		".long 0x0025200f"
+#define CBO_INVAL_A0		".long 0x0005200f"
+
+/*
+ * Placed in .data (not BSS) -- called from start.S before BSS init.
+ * -1 = not yet detected, 0 = new CPU (Zicbom), 1 = legacy C9xx
+ *
+ * Legacy C9xx (c906/c910/c920): mvendorid=0x5b7, marchid=0, mimpid=0
+ * New CPUs (c920v2/c925/c930/c950): mvendorid=0x5b7, marchid!=0
+ */
+static int legacy_c9xx __section(".data") = -1;
+
+static int is_xuantie_legacy_c9xx(void)
+{
+	if (legacy_c9xx < 0) {
+		long mvendorid = 0, marchid = -1, mimpid = -1;
+		int ret = -1;
+#if CONFIG_IS_ENABLED(RISCV_SMODE)
+		ret = sbi_get_mvendorid(&mvendorid);
+		if (!ret)
+			ret = sbi_get_marchid(&marchid);
+		if (!ret)
+			ret = sbi_get_mimpid(&mimpid);
+#elif CONFIG_IS_ENABLED(RISCV_MMODE)
+		mvendorid = csr_read(CSR_MVENDORID);
+		marchid = csr_read(CSR_MARCHID);
+		mimpid = csr_read(CSR_MIMPID);
+		ret = 0;
+#endif
+		if (ret)
+			legacy_c9xx = 0;
+		else
+			legacy_c9xx = (mvendorid == XUANTIE_VENDOR_ID &&
+				       marchid == 0 &&
+				       mimpid == 0) ? 1 : 0;
+	}
+	return legacy_c9xx;
+}
+
+void invalidate_icache_all(void)
+{
+	if (is_xuantie_legacy_c9xx()) {
+		asm volatile (XUANTIE_ICACHE_IALL ::: "memory");
+		asm volatile (XUANTIE_SYNC_I ::: "memory");
+	} else {
+		asm volatile ("fence.i" ::: "memory");
+	}
+}
+
+void flush_dcache_all(void)
+{
+	if (is_xuantie_legacy_c9xx()) {
+		asm volatile (XUANTIE_DCACHE_CALL ::: "memory");
+		asm volatile (XUANTIE_SYNC_S ::: "memory");
+	} else {
+		asm volatile ("fence iorw, iorw" ::: "memory");
+	}
+}
+
+void invalidate_dcache_all(void)
+{
+	if (is_xuantie_legacy_c9xx()) {
+		asm volatile (XUANTIE_DCACHE_IALL ::: "memory");
+		asm volatile (XUANTIE_SYNC_S ::: "memory");
+	} else {
+		asm volatile ("fence iorw, iorw" ::: "memory");
+	}
+}
+
+void flush_dcache_range(unsigned long start, unsigned long end)
+{
+	unsigned long aligned = start & ~(CONFIG_SYS_CACHELINE_SIZE - 1);
+
+	if (is_xuantie_legacy_c9xx()) {
+		register unsigned long i asm("a0") = aligned;
+
+		for (; i < end; i += CONFIG_SYS_CACHELINE_SIZE)
+			asm volatile (XUANTIE_DCACHE_CIPA_A0);
+		asm volatile (XUANTIE_SYNC_S);
+	} else {
+		register unsigned long i asm("a0") = aligned;
+
+		for (; i < end; i += CONFIG_SYS_CACHELINE_SIZE)
+			asm volatile (CBO_FLUSH_A0 ::: "memory");
+		asm volatile ("fence iorw, iorw" ::: "memory");
+	}
+}
+
+void invalidate_dcache_range(unsigned long start, unsigned long end)
+{
+	unsigned long aligned = start & ~(CONFIG_SYS_CACHELINE_SIZE - 1);
+
+	if (is_xuantie_legacy_c9xx()) {
+		register unsigned long i asm("a0") = aligned;
+
+		for (; i < end; i += CONFIG_SYS_CACHELINE_SIZE)
+			asm volatile (XUANTIE_DCACHE_IPA_A0);
+		asm volatile (XUANTIE_SYNC_S);
+	} else {
+		register unsigned long i asm("a0") = aligned;
+
+		for (; i < end; i += CONFIG_SYS_CACHELINE_SIZE)
+			asm volatile (CBO_INVAL_A0 ::: "memory");
+		asm volatile ("fence iorw, iorw" ::: "memory");
+	}
+}
