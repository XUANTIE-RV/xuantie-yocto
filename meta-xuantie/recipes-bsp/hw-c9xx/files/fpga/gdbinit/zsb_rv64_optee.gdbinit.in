# Set gdb environment
set confirm off
set height  0
set remotetimeout 20
monitor set resume-bkpt-exception on

define import_string_env
        shell echo set \$$arg0=\"$(echo $$arg0)\" > .gdb.tmp
        source .gdb.tmp
end

define restore_xt
        set $img = $arg0
        set $addr = $arg2

        shell rm -f .gdb.log
        set logging file .gdb.log
        set logging enabled on
        printf "restore %s binary 0x%x\n", $img, $addr
        set logging enabled off

        source .gdb.log
end

import_string_env image_zsb
import_string_env bl31_path
import_string_env teeos_path
import_string_env image_dtb
import_string_env image_kernel
import_string_env image_rootfs

# OP-TEE memory layout: kernel/rootfs live in the 0x8xxxxxxx window (matches
# the optee DTS linux,initrd-start); bl31 (secure monitor) + tee-os are secure.
set $vmlinux_addr = ${VMLINUX_ADDR}
set $rootfs_addr  = ${ROOTFS_ADDR}
set $zsb_addr     = ${ZSB_ADDR}
set $dtb_addr     = ${DTB_ADDR}
set $bl31_addr    = ${BL31_ADDR}
set $teeos_addr   = ${TEEOS_ADDR}

# Load zsb for tee
restore_xt $image_zsb                                                   binary $zsb_addr
# Load bl31
restore_xt $bl31_path                                                   binary $bl31_addr
# load tee
restore_xt $teeos_path                                                  binary $teeos_addr
# Load dtb
restore_xt $image_dtb                                                   binary $dtb_addr
# Load rootfs & kernel
restore_xt $image_kernel                                                binary $vmlinux_addr
restore_xt $image_rootfs                                                binary $rootfs_addr

# Set flag to 0, controlled by hardware
set $flag_addr    = ${FLAG_ADDR}
set *(unsigned int *)$flag_addr = 0x0

# Set all harts reset address
##REPEAT CORES##
${RESET_PREFIX}set *(unsigned long *)${RESET_ADDR} = $zsb_addr
##ENDREPEAT##
set $pc         = $zsb_addr
# Release all harts from reset
${RELEASE}
echo Finished GDBINIT\n\n
