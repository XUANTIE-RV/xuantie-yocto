# All conf/distro/*.conf and conf/machine/*.conf are auto-generated by
# scripts/gen-cpu-confs.sh from cpu-isa-mapping.conf (the SoT). Do NOT
# commit them — regenerate via `bash scripts/gen-cpu-confs.sh` after a
# toolchain or mapping change.
conf/distro/*.conf
conf/machine/*.conf

# Helper .inc files under conf/distro/include/ are hand-written; keep tracked.
!conf/distro/include/
!conf/distro/include/**

# .gitignore.distro is the per-CPU manifest written by gen-cpu-confs.sh
# for snapshot/diff purposes; it is intentionally tracked.
