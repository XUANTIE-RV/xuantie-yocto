TOOLCHAIN ?= "${TOOLCHAIN_ISA_DEFAULT}"
EXTERNAL_TOOLCHAIN = "${EXTERNAL_TOOLCHAIN_GCC}"
EXTERNAL_TOOLCHAIN:toolchain-clang = "${EXTERNAL_TOOLCHAIN_CLANG}"

def _xuantie_get_clang_version(d):
    """Auto-detect clang version via clang -dumpversion."""
    import os, subprocess
    tc = d.getVar('EXTERNAL_TOOLCHAIN_CLANG')
    if not tc:
        return 'UNKNOWN'
    clang = os.path.join(tc, 'bin', 'clang')
    if not os.path.isfile(clang):
        return 'UNKNOWN'
    try:
        return subprocess.check_output(
            [clang, '-dumpversion'], stderr=subprocess.DEVNULL, text=True).strip() or 'UNKNOWN'
    except Exception:
        return 'UNKNOWN'

CLANG_VERSION = "${@_xuantie_get_clang_version(d)}"

def _xuantie_get_gcc_version_from_gcc_toolchain(d):
    """Get GCC version from the GCC toolchain, even when using clang.

    When TOOLCHAIN=clang, EXTERNAL_TOOLCHAIN points to the clang toolchain
    which has no gcc binary. But libgcc-external/gcc-runtime-external still
    need GCC_VERSION from the actual GCC toolchain."""
    import os, subprocess
    tc_gcc = d.getVar('EXTERNAL_TOOLCHAIN_GCC')
    target_sys = d.getVar('EXTERNAL_TARGET_SYS')
    if not tc_gcc or not target_sys:
        return 'UNKNOWN'
    gcc = os.path.join(tc_gcc, 'bin', target_sys + '-gcc')
    if not os.path.isfile(gcc):
        return 'UNKNOWN'
    try:
        return subprocess.check_output(
            [gcc, '-dumpversion'], stderr=subprocess.DEVNULL, text=True).strip() or 'UNKNOWN'
    except Exception:
        return 'UNKNOWN'

GCC_VERSION:toolchain-clang = "${@_xuantie_get_gcc_version_from_gcc_toolchain(d)}"

EXTERNAL_CC:toolchain-clang = "clang"

# Tell clang where to find GCC runtime files (crtbegin.o, libgcc.a, crtend.o).
# Without this, clang detects an incomplete GCC installation in the recipe sysroot
# (which only has include/ dir) and fails to link.
# -menable-experimental-extensions is injected for clang whenever:
#   - TOOLCHAIN_VENDOR=xuantie (XuanTie clang toolchain), or
#   - TOOLCHAIN_VENDOR=riscv-gnu (open-source clang — many CPU-named distros
#     auto-generated by gen-cpu-confs.sh include experimental ISA extensions
#     such as zicfilp/zicfiss/xvqdotq in their -march, and clang rejects the
#     arch string without the opt-in flag), or
#   - the selected arch profile sets XUANTIE_ARCH_NEEDS_EXP_EXTENSIONS=1
#     (e.g. rva23u64/rvb23u64 contain experimental extensions like zimop).
# The flag is a no-op when the -march contains no experimental extensions, so
# enabling it unconditionally for clang is safe.
TUNE_CCARGS:append:toolchain-clang = " --gcc-toolchain=${EXTERNAL_TOOLCHAIN_CLANG} -menable-experimental-extensions"

# Recipes that consume XUANTIE_TUNE_CCARGS{,_GENERIC} directly (benchmark
# bbclass which builds CC/CXX from these, plus recipes like spec2006 that
# sed-substitute XUANTIE_TUNE_CCARGS_GENERIC into their config files) bypass
# TUNE_CCARGS, so the experimental-extensions flag must be appended here too.
XUANTIE_TUNE_CCARGS:append:toolchain-clang = " -menable-experimental-extensions"
XUANTIE_TUNE_CCARGS_GENERIC:append:toolchain-clang = " -menable-experimental-extensions"

PREFERRED_PROVIDER_clang-cross-${TARGET_ARCH} ?= "clang-external-cross-${TARGET_ARCH}"

