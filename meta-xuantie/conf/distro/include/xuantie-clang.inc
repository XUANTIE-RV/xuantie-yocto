
EXTERNAL_TOOLCHAIN_GCC = "${TOPDIR}/../../riscv-toolchain-gcc"
export EXTERNAL_TOOLCHAIN_EXPORT_GCC = "${EXTERNAL_TOOLCHAIN_GCC}"
BB_BASEHASH_IGNORE_VARS:append = " EXTERNAL_TOOLCHAIN_GCC EXTERNAL_TOOLCHAIN_EXPORT_GCC"
GCC_VERSION:forcevariable = "14.1.1"

TOOLCHAIN = "gcc"
EXTERNAL_TOOLCHAIN = "${EXTERNAL_TOOLCHAIN_GCC}"
CLANG_VERSION = "18.1.8"
EXTERNAL_CC:toolchain-clang = "clang"
PREFERRED_PROVIDER_clang-cross-${TARGET_ARCH} ?= "clang-external-cross-${TARGET_ARCH}"
