++	if (READ_ONCE(vcpu->arch.irqs_pending_mask[1])) {
++		mask = xchg_acquire(&vcpu->arch.irqs_pending_mask[1], 0);
++		val = READ_ONCE(vcpu->arch.irqs_pending[1]) & mask;
