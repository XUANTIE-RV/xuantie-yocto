Date: Thu, 16 Jan 2025 21:45:54 +0800
Subject: [PATCH] disable CONFIG_DEBUG_INFO_BTF

---
 arch/riscv/configs/vdebug.config | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/riscv/configs/vdebug.config b/arch/riscv/configs/vdebug.config
index 6faf30ec7420..888022740c0c 100644
--- a/arch/riscv/configs/vdebug.config
+++ b/arch/riscv/configs/vdebug.config
@@ -1,6 +1,13 @@
 ## DEBUG_INFO
 CONFIG_DEBUG_INFO=y
+# CONFIG_DEBUG_INFO_NONE is not set
 CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
+CONFIG_DEBUG_INFO_REDUCED=y
+CONFIG_DEBUG_INFO_COMPRESSED_NONE=y
+# CONFIG_DEBUG_INFO_COMPRESSED_ZLIB is not set
+CONFIG_PAHOLE_HAS_SPLIT_BTF=y
+CONFIG_PAHOLE_HAS_LANG_EXCLUDE=y
+# CONFIG_GDB_SCRIPTS is not set
 ## common
 CONFIG_KUNIT=y
 CONFIG_SAMPLES=y
