+static void get_zspage_mapping(struct zspage *zspage,
+			       unsigned int *class_idx,
+			       int *fullness)
+{
+	BUG_ON(zspage->magic != ZSPAGE_MAGIC);
+
+	*fullness = zspage->fullness;
+	*class_idx = zspage->class;
+}
