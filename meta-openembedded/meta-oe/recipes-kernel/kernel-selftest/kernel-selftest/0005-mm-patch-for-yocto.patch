+		SECTIONS_SHIFT,
+		NODES_SHIFT,
+		ZONES_SHIFT,
+		LAST_CPUPID_SHIFT,
+		KASAN_TAG_WIDTH);
+	mminit_dprintk(MMINIT_TRACE, "pageflags_layout_pgshifts",
