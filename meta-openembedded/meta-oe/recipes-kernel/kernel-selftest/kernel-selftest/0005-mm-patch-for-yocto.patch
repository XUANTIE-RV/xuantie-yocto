+void munlock_folio(struct folio *folio);
+static inline void munlock_vma_folio(struct folio *folio,
+			struct vm_area_struct *vma, bool compound)
+{
+	if (unlikely(vma->vm_flags & VM_LOCKED) &&
+	    (compound || !folio_test_large(folio)))
+		munlock_folio(folio);
+}
